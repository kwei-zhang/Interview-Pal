# Server-only runtime credentials. Use the restricted interview_runtime role.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Canonical website origin for account emails (HTTPS in production).
AUTH_SITE_URL=http://127.0.0.1:3000
# Build-time deployment prefix. Leave empty locally; use /interview on kwei.me.
NEXT_PUBLIC_BASE_PATH=

# OpenAI interviewer: typed conversation, live WebRTC voice, and saved feedback.
# Never use NEXT_PUBLIC_ for the API key.
OPENAI_API_KEY=
OPENAI_INTERVIEW_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Local demo activates only in development when Neon is not configured.
# Production requires Neon. Registration requires an email-bound invitation.

# Database schema administration only; never set on Vercel / the running app.
# SCHEMA_DATABASE_URL=
